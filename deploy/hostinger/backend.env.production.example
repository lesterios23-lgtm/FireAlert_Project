# ---------------------------------------------------------------------------
# FireAlert backend - production environment for Hostinger
#
# Copy this file to  firealert/.env  on the server and fill in the blanks.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

APP_NAME=FireAlert
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Your public site. Must be https and match the domain exactly.
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Password hashing cost. 12 is a good default for shared hosting CPUs.
BCRYPT_ROUNDS=12

# Daily log files in storage/logs. Never use "debug" in production.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database - use the credentials from hPanel > Databases > MySQL Databases
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_firealert
DB_USERNAME=u000000000_firealert
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions and cache
# "file" needs no extra table and is reliable on shared hosting.
# "database" also works: the sessions and cache tables are part of the schema.
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file

# Nothing in this application queues jobs, and shared hosting has no worker.
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# Evidence photos are read through the API (local disk).
# Profile photos are served from public_html/storage (public disk).
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# JWT (php-open-source-saver/jwt-auth)
# Generate the secret with:  php artisan jwt:secret
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_TTL=60
JWT_ALGO=HS256

# ---------------------------------------------------------------------------
# First administrator - only used by ReferenceDataSeeder.
# Leave empty to skip. Set these, seed once, then remove them.
# ---------------------------------------------------------------------------
FIREALERT_ADMIN_EMAIL=
FIREALERT_ADMIN_PASSWORD=
FIREALERT_ADMIN_NAME="System Administrator"
FIREALERT_ADMIN_CONTACT=

# ---------------------------------------------------------------------------
# Mail - "log" writes messages to storage/logs instead of sending them.
# Configure real SMTP credentials if password-reset email is needed.
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Duplicate-report detection (optional, these are the code defaults)
# ---------------------------------------------------------------------------
# DUPLICATE_RADIUS_METERS=200
# DUPLICATE_WINDOW_MINUTES=15
# DUPLICATE_DESCRIPTION_THRESHOLD=0.35
# DUPLICATE_TIGHT_RADIUS_METERS=60
