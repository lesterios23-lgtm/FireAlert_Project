# ---------------------------------------------------------------------------
# FireAlert - Hostinger document root (public_html)
#
# One domain serves both parts of the system:
#   /api/v1/...  -> Laravel (PHP)
#   everything else -> React single-page app (index.html)
# ---------------------------------------------------------------------------

# The SPA shell is the directory index, not Laravel's index.php.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Pass the Authorization header to PHP (needed for JWT Bearer tokens).
    # Some Apache/CGI setups strip it, which would make every API call 401.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Force HTTPS (Hostinger provides a free SSL certificate).
    # The X-Forwarded-Proto check avoids a redirect loop behind a proxy.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Backend routes -> Laravel front controller.
    RewriteRule ^(api|up|sanctum)(/.*)?$ index.php [L,QSA]

    # Real files and folders: hashed build assets, the storage symlink, uploads.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Serve public storage files via index.php if hbuilds removed the storage symlink.
    RewriteRule ^storage/(.+)$ index.php [L,QSA]

    # Anything else is a client-side route handled by React.
    RewriteRule ^ index.html [L]
</IfModule>

# Never expose secrets or application sources, even if they end up here.
<FilesMatch "^\.env|^\.git|^composer\.(json|lock)$|^artisan$|^phpunit\.xml$">
    Require all denied
</FilesMatch>

# Hashed bundle files never change, so they can be cached for a year.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Never cache the SPA entry shell, manifest, or service worker so mobile PWAs
# always pick up deployed fixes immediately instead of serving stale bundles.
<FilesMatch "^(index\.html|service-worker\.js|manifest\.json|asset-manifest\.json)$">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
