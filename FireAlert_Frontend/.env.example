# API base URL.
#   Empty in development  -> http://<current host>:8000/api/v1
#   Empty in a production build -> /api/v1 on the same domain (recommended for
#   Hostinger, see deploy/hostinger/README.md).
# Set an absolute URL only when the API lives on another domain, e.g.
#   REACT_APP_API_URL=https://api.example.com/api/v1
# Values are baked in at build time; changing them on the server does nothing.
REACT_APP_API_URL=

# Google OAuth client ID for the "Sign in with Google" button.
# Add your production domain to the client's authorized JavaScript origins in
# Google Cloud Console, otherwise the button fails silently.
REACT_APP_GOOGLE_CLIENT_ID=

# Google Maps JavaScript API key for the route/navigation map. Leave empty to
# use the built-in Leaflet/OpenStreetMap map instead. Baked in at build time.
REACT_APP_GOOGLE_MAPS_API_KEY=

# Development server only (ignored by `npm run build`).
# Bind to all interfaces so phones on the same Wi-Fi/hotspot can open the dev
# server. Set HOST=localhost to restrict it to this computer again.
HOST=0.0.0.0
PORT=3000
