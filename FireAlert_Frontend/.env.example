# Leave empty to use the API on the same host as the page, port 8000, in
# development (localhost or the machine's current LAN address), and
# same-origin /api/v1 in production.
REACT_APP_API_URL=

# Bind to all interfaces so phones on the same Wi-Fi/hotspot can open the dev
# server. Set HOST=localhost to restrict it to this computer again.
HOST=0.0.0.0
PORT=3000

# Google Maps JavaScript API key for the route/navigation map. Leave empty to
# use the built-in Leaflet/OpenStreetMap map instead.
REACT_APP_GOOGLE_MAPS_API_KEY=
